# Generated by ./install.sh. Copy manually only if you skip the installer.
DOMAIN=mail.example.com
PUBLIC_URL=https://mail.example.com
# caddy | tunnel | empty when using your own reverse proxy
COMPOSE_PROFILES=caddy
CLOUDFLARE_TUNNEL_TOKEN=
WEB_BIND=127.0.0.1:3000
POSTGRES_PASSWORD=change-me
# 32 random bytes, base64. Encrypts saved Resend and R2 credentials.
APP_SECRET=
# Resend's default team limit is 10 requests/second.
RESEND_RPS=10
